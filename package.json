{
  "name": "@mirafive/node",
  "version": "2.3.0",
  "description": "MIRA FIVE server SDK for Node, Bun, Deno and edge runtimes: server events, revenue and touchpoints, with batching, retries and exactly-once event ids. No dependencies beyond @mirafive/protocol.",
  "keywords": [
    "analytics",
    "attribution",
    "bun",
    "deno",
    "mira-five",
    "mirafive",
    "node",
    "revenue",
    "server"
  ],
  "homepage": "https://github.com/mirafive/sdk-node#readme",
  "bugs": {
    "url": "https://github.com/mirafive/sdk-node/issues"
  },
  "license": "MIT",
  "author": "Cloo GmbH <hallo@mirafive.io> (https://mirafive.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirafive/sdk-node.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@mirafive/protocol": "^2.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.4"
}
